# =====================================================================================
# WHITE CARRARA — impostazioni del sito
# Copiate questo file in ".env" (sviluppo sul vostro computer) oppure inserite le stesse
# voci nel pannello di Vercel o Netlify (Settings → Environment Variables).
# Il file .env NON va mai caricato su GitHub: contiene chiavi segrete.
#
# Le voci che iniziano con PUBLIC_ finiscono nel codice del browser: non metteteci segreti.
# Tutte le altre restano sul server.
# Se una voce manca, la funzione relativa si spegne in modo sicuro e il sito lo dice
# (per esempio: senza RESEND_API_KEY le richieste vengono salvate ma non parte l'email).
# =====================================================================================

# --- Indirizzo del sito --------------------------------------------------------------
# Usato per i link nelle email, la mappa del sito, i tag canonical e hreflang.
PUBLIC_SITE_URL=https://www.whitecarrara.com

# --- Database e accesso (Supabase) ---------------------------------------------------
# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# SEGRETA: permette operazioni da amministratore (creare account, inviare link). Solo sul server.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (porta 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Connessioni contemporanee per istanza del server (3 va bene per Vercel/Netlify)
DATABASE_POOL_MAX=3

# --- Amministratori ------------------------------------------------------------------
# Chi si registra con uno di questi indirizzi diventa amministratore (separati da virgola).
# Agli amministratori è sempre richiesta la verifica in due passaggi (app di autenticazione).
ADMIN_EMAILS=mazzucchellipietro6@gmail.com
# Dove arrivano le notifiche di nuove richieste, prenotazioni e messaggi
ADMIN_NOTIFY_EMAIL=mazzucchellipietro6@gmail.com

# --- Email (Resend) ------------------------------------------------------------------
# resend.com → API Keys. Il dominio del mittente va verificato in Resend (record DNS).
RESEND_API_KEY=
EMAIL_FROM="WHITE CARRARA <noreply@whitecarrara.com>"
EMAIL_REPLY_TO=mazzucchellipietro6@gmail.com
# Solo per sviluppo/test: salva le email come file in questa cartella invece di inviarle
# EMAIL_OUTBOX_DIR=./outbox

# --- Protezione dei moduli (Cloudflare Turnstile) ------------------------------------
# dash.cloudflare.com → Turnstile → Add site. Senza chiavi i moduli restano protetti da
# limite di invii, campo trappola e controllo dei tempi, ma senza verifica anti-bot.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Pagamenti (Stripe, facoltativo) -------------------------------------------------
# Solo per servizi confermati e autorizzati: il link di pagamento lo crea lo staff dal pannello.
# Per le prove usate le chiavi di test (sk_test_...).
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://VOSTRO-DOMINIO/api/stripe/webhook
# eventi: checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# --- Intelligenza artificiale (Marble Matching e Marble Concierge, facoltativo) ------
# Senza chiave il Marble Matching usa l'analisi locale di colori e venature e il Concierge
# propone i marmi con regole semplici.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modello e livello di ragionamento (lasciate vuoto per i valori consigliati)
# AI_MODEL=
# AI_EFFORT=medium
# Limiti per contenere i costi
AI_MATCH_PER_HOUR=12
AI_DAILY_LIMIT=300

# --- Azienda AI: servizio agenti (cartella agents/, vedi docs/AI-COMPANY.md) ----------
# La stessa ANTHROPIC_API_KEY qui sopra fa lavorare i 25 agenti. Senza chiave gli incarichi
# restano in coda e la sede 3D mostra tutti gli agenti come "non collegati".
# Connessione al database per il servizio: su Supabase usate la modalità "session" (porta 5432),
# perché la modalità "transaction" (6543) non supporta LISTEN/NOTIFY. Vuoto = DATABASE_URL.
AGENTS_DATABASE_URL=
# Modello predefinito degli agenti (ognuno si può cambiare dal pannello → Azienda AI → Agenti)
# AGENTS_MODEL=claude-opus-5-5
# Token per le chiamate da server a server all'API del servizio (stringa lunga e casuale)
AGENTS_API_TOKEN=
# Segreto condiviso tra pannello e servizio per il flusso di eventi in tempo reale (WebSocket)
AGENTS_WS_SECRET=
# Indirizzo pubblico del servizio agenti (per il WebSocket dal browser), es. https://agents.example.com
AGENTS_PUBLIC_URL=
# Limiti di sicurezza sulla spesa (il budget per agente e il tetto giornaliero si cambiano dal pannello)
# MAX_TURNS_PER_TASK=14
# MAX_COST_PER_TASK_USD=3
# WORKER_CONCURRENCY=3
# Email commerciali approvate dal fondatore (Resend): stessi RESEND_API_KEY ed EMAIL_FROM del sito

# --- Traduzioni automatiche (Google Cloud Translation, facoltativo) ------------------
# console.cloud.google.com → API "Cloud Translation API" → Credenziali → Chiave API
# (limitatela alla sola Cloud Translation API). Usata solo durante la build.
GOOGLE_TRANSLATE_API_KEY=
# Lingue in più oltre alle 16 principali: "all" per tutte, oppure un elenco (sv,da,el)
# TRANSLATE_EXTRA=
# Tetto ai caratteri inviati per ogni build (circa 1 milione basta per le 16 lingue)
# TRANSLATE_BUDGET_CHARS=2000000

# --- Statistiche (facoltative, attive solo dopo il consenso ai cookie) ---------------
# Plausible: il dominio registrato su plausible.io
PUBLIC_PLAUSIBLE_DOMAIN=
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Google Analytics 4: ID di misurazione (G-XXXXXXX)
PUBLIC_GA4_ID=

# --- Pannello contenuti (Keystatic, testi di marmi, esperienze, destinazioni) --------
# Con GitHub: le modifiche fatte in /keystatic diventano commit nel repository.
# KEYSTATIC_GITHUB_REPO=proprietario/repository
# KEYSTATIC_PATH_PREFIX=
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Pulsante "Pubblica" del pannello: Deploy Hook di Vercel/Netlify che ricostruisce il sito
# DEPLOY_HOOK_URL=
