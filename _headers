# Intestazioni HTTP del sito su Cloudflare Pages (GitHub Pages le ignora). Il workflow copia questo file in _site.
# Valgono solo per i file statici: le risposte delle funzioni (/api/...) mettono da sole le loro intestazioni.
# Controllato da tests/cloudflare.test.mjs: ogni indirizzo esterno che il sito carica deve essere qui.
#
# Content-Security-Policy, cosa permette e perché:
#   script-src   solo i file del sito e lo script del tema scritto in <head> di ogni pagina, autorizzato con la sua
#                impronta (sha256) invece di 'unsafe-inline': così uno script iniettato con un testo delle aste non
#                parte. Lo script è identico in tutte le pagine: se lo cambi, aggiorna l'impronta (il test la
#                ricalcola e dice quale mettere). Niente 'unsafe-eval': il sito non lo usa.
#   style-src    'unsafe-inline' serve agli attributi style="..." scritti dalle pagine e da Leaflet (solo stili, non
#                codice).
#   img-src      tile di OpenStreetMap (sfondo della mappa), foto delle aste dal Portale Vendite Pubbliche
#                (resource-pvp.giustizia.it) e data: (immagini vuote di Leaflet).
#   connect-src  nominatim.openstreetmap.org (cerca un luogo sulla mappa) e il progetto Supabase degli account
#                (*.supabase.co). Se usi un dominio personalizzato per Supabase, aggiungilo qui.
#   Stripe Checkout, il portale clienti di Stripe e l'accesso con Google sono pagine su cui il sito porta
#   l'utente (navigazione): non servono nella CSP. Documenti e avvisi delle aste sono link, idem.
#   frame-ancestors 'none' (e X-Frame-Options) impedisce di mostrare il sito dentro altri siti.
#
# Referrer-Policy: verso gli altri siti va solo l'indirizzo del sito, senza pagina né parametri. Le regole d'uso
# delle tile e di Nominatim di OpenStreetMap chiedono che il sito si faccia riconoscere: non usare no-referrer.
# Permissions-Policy: spegne fotocamera, microfono, posizione, pagamenti nel browser e sensori, che il sito non usa;
# lascia "condividi" (scheda dell'asta). Se un giorno servirà la posizione ("vicino a me"), cambia geolocation=(self).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-AuRrEURHuEvIPVaIwyFxbQnSFt5SRQtPHQyFcTZ7IAE='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org https://resource-pvp.giustizia.it; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), browsing-topics=(), web-share=(self)
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Caratteri e librerie: non cambiano, il browser li tiene un anno. Se aggiorni una libreria in assets/vendor/,
# cambia il nome della cartella o del file (es. leaflet-1.9.5/), altrimenti chi ha già visitato il sito tiene la vecchia.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Dati del giorno: il browser chiede sempre al sito se sono cambiati (risposta leggera se sono uguali), mai dati vecchi.
/data/*
  Cache-Control: no-cache

# Service worker: va ricontrollato a ogni visita, altrimenti gli aggiornamenti del sito arrivano tardi.
/sw.js
  Cache-Control: no-cache
