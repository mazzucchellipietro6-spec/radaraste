# Intestazioni HTTP del sito su Cloudflare Pages (GitHub Pages le ignora). Il workflow copia questo file in _site.
# Valgono solo per i file statici: le risposte delle funzioni (/api/...) mettono da sole le loro intestazioni.
# Controllato da tests/cloudflare.test.mjs: ogni indirizzo esterno che il sito carica deve essere qui, e ogni
# indirizzo che è qui deve servire a qualcosa. Provato nel browser il 29/10/2026: nessuna violazione nelle pagine.
#
# Content-Security-Policy, cosa permette e perché:
#   script-src   solo i file del sito e lo script del tema scritto in <head> di ogni pagina, autorizzato con la sua
#                impronta (sha256) invece di 'unsafe-inline': così uno script iniettato con un testo delle aste non
#                parte. Lo script è identico in tutte le pagine: se lo cambi, aggiorna l'impronta (il test la
#                ricalcola e dice quale mettere). Niente 'unsafe-eval': il sito e le librerie non lo usano.
#   style-src    'unsafe-inline' serve agli attributi style="..." scritti dalle pagine, da Leaflet e da MapLibre
#                (solo stili, non codice).
#   img-src      tile di OpenStreetMap (sfondo della mappa), foto delle aste dal Portale Vendite Pubbliche
#                (resource-pvp.giustizia.it), data: (immagini vuote di Leaflet) e blob: (immagini che MapLibre
#                ricava dai file scaricati).
#   connect-src  nominatim.openstreetmap.org (posizione delle aste inserite a mano, nella mappa); il progetto
#                Supabase degli account (*.supabase.co: se usi un dominio personalizzato, aggiungilo qui);
#                tiles.openfreemap.org (Radar 3D: stile, tile vettoriali, caratteri e icone) e tile.openstreetmap.org
#                (Radar 3D, sfondo di ripiego): MapLibre scarica tutto con fetch, quindi servono qui e non in img-src.
#   worker-src   solo 'self': il service worker (sw.js) e il worker di MapLibre, che è un file del sito (versione
#                "csp" di MapLibre con setWorkerUrl, che elabora anche le tile vettoriali). Niente blob:: provato nel
#                browser il 29/10/2026 (Radar 3D con lo sfondo OpenStreetMap e con i confini delle regioni, tutte le
#                altre pagine) senza violazioni; deck.gl qui non crea worker.
#   Stripe Checkout, il portale clienti di Stripe e l'accesso con Google sono pagine su cui il sito porta
#   l'utente (navigazione): non servono nella CSP, e nessuno script o richiesta va a Stripe dal browser.
#   I moduli del sito si inviano solo al sito (form-action 'self'). Documenti e avvisi delle aste sono link.
#   frame-ancestors 'none' (e X-Frame-Options) impedisce di mostrare il sito dentro altri siti.
#   Se un giorno sw.js metterà in cache foto o tile di altri siti, quegli indirizzi vanno anche in connect-src
#   (il test lo controlla).
#
# Referrer-Policy: verso gli altri siti va solo l'indirizzo del sito, senza pagina né parametri. Le regole d'uso
# delle tile e di Nominatim di OpenStreetMap chiedono che il sito si faccia riconoscere: non usare no-referrer.
# Permissions-Policy: spegne fotocamera, microfono, posizione, pagamenti nel browser e sensori, che il sito non usa.
# "Condividi" (scheda dell'asta) e lo schermo intero restano permessi al sito, come di norma. Se un giorno servirà
# la posizione ("vicino a me"), cambia geolocation=(self).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-AuRrEURHuEvIPVaIwyFxbQnSFt5SRQtPHQyFcTZ7IAE='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://resource-pvp.giustizia.it; font-src 'self'; connect-src 'self' https://nominatim.openstreetmap.org https://*.supabase.co https://tiles.openfreemap.org https://tile.openstreetmap.org; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), midi=(), accelerometer=(), gyroscope=(), magnetometer=(), display-capture=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Caratteri e librerie: non cambiano, il browser li tiene un anno senza ricontrollarli. Se aggiorni una libreria in
# assets/vendor/, cambia il nome della cartella o del file (es. maplibre-gl-5.24.0/), altrimenti chi ha già visitato
# il sito tiene la vecchia fino a un anno.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Dati del giorno: il browser chiede sempre al sito se sono cambiati (risposta leggera se sono uguali), mai dati vecchi.
/data/*
  Cache-Control: no-cache

# Service worker: va ricontrollato a ogni visita, altrimenti gli aggiornamenti del sito arrivano tardi.
/sw.js
  Cache-Control: no-cache
