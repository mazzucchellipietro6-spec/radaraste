---
import Admin from '~/layouts/Admin.astro';
import RecordForm from '~/components/admin/RecordForm.astro';
import { canAccess, resource } from '~/lib/server/admin/resources';
import { getRow, marbleOptions, refOptions, resolveOptions } from '~/lib/server/admin/data';
import { withUser } from '~/lib/server/db';
import { stripeConfigured } from '~/lib/server/stripe';
export const prerender = false;
const r = resource('quotes')!;
const admin = Astro.locals.admin;
if (!admin || !canAccess(r, admin.profile)) return Astro.redirect('/admin/');
const id = Astro.params.id ?? '';
const row = await getRow(admin.user, r, id);
if (!row) return Astro.redirect('/admin/quotes/');
const options = await resolveOptions(admin.user, r);
const trade = admin.profile.role === 'admin' || admin.profile.permissions.includes('trade');
type Item = { id: string; position: number; marble_slug: string | null; description: string; finish: string | null; thickness: string | null; quantity: string; unit: string; unit_price: string; supplier_id: string | null; material_id: string | null; unit_cost: string | null; commission_percent: string | null };
const items = await withUser(admin.user.claims, (tx) =>
  trade
    ? tx<Item[]>`select i.*, c.supplier_id, c.material_id, c.unit_cost, c.commission_percent from public.quote_items i left join public.quote_item_costs c on c.quote_item_id = i.id where i.quote_id = ${id} order by i.position, i.created_at`
    : tx<Item[]>`select i.*, null::uuid as supplier_id, null::uuid as material_id, null::numeric as unit_cost, null::numeric as commission_percent from public.quote_items i where i.quote_id = ${id} order by i.position, i.created_at`,
);
const marbles = await marbleOptions();
const suppliers = trade ? await refOptions(admin.user, 'suppliers') : [];
const materials = trade ? await refOptions(admin.user, 'materials') : [];
const revenue = items.reduce((s, i) => s + Number(i.quantity) * Number(i.unit_price), 0);
const cost = items.reduce((s, i) => s + Number(i.quantity) * Number(i.unit_cost ?? 0), 0);
const commission = items.reduce((s, i) => s + (Number(i.quantity) * Number(i.unit_price) * Number(i.commission_percent ?? 0)) / 100, 0);
const eur = (n: number) => n.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const sp = Astro.url.searchParams;
const deposit = Number(row.deposit_percent ?? 0);
---

<Admin title={`Preventivo ${row.number}`} active="quotes" wide>
  <p class="mt-2"><a href="/admin/quotes/" class="text-brass-deep">← Preventivi</a></p>
  {sp.get('ok') && <p class="mt-4 border border-success px-4 py-2 text-success" role="status">{sp.get('ok') === '1' ? 'Salvato.' : sp.get('ok')}</p>}
  {sp.get('error') && <p class="mt-4 border border-danger px-4 py-2 text-danger" role="alert">{sp.get('error')}</p>}

  <section class="adm-card mt-6">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="font-display text-xl">Righe del preventivo</h2>
      <p class="text-[0.95rem]">Totale cliente: <strong>{eur(revenue)} {row.currency}</strong>{trade && <> · Costo: {eur(cost)} · {row.model === 'brokerage' ? <>Provvigione stimata: <strong>{eur(commission)}</strong></> : <>Margine: <strong>{eur(revenue - cost)}</strong></>}</>}</p>
    </div>
    {trade && <p class="mt-1 text-[0.8rem] text-ash">Fornitore, costi e provvigioni sono dati interni: il cliente vede solo descrizione, quantità e prezzo.</p>}
    <div class="mt-4 overflow-x-auto">
      <table class="adm-table">
        <thead><tr><th>Descrizione</th><th>Finitura / spessore</th><th>Q.tà</th><th>Prezzo unit.</th>{trade && <><th>Fornitore</th><th>Costo unit.</th><th>Provv. %</th></>}<th /></tr></thead>
        <tbody>
          {items.map((i) => (
            <tr>
              <td colspan={trade ? 8 : 5} class="!p-0">
                <form method="post" action="/api/admin/quotes/item" class="grid items-end gap-2 p-2 md:grid-cols-[2fr_1fr_6rem_7rem_repeat(3,minmax(6rem,1fr))_auto]">
                  <input type="hidden" name="quote_id" value={id} /><input type="hidden" name="item_id" value={i.id} />
                  <input class="input !min-h-9 text-[0.85rem]" name="description" value={i.description} required />
                  <span class="flex gap-1"><input class="input !min-h-9 text-[0.85rem]" name="finish" value={i.finish ?? ''} placeholder="finitura" /><input class="input !min-h-9 text-[0.85rem]" name="thickness" value={i.thickness ?? ''} placeholder="spess." /></span>
                  <span class="flex gap-1"><input class="input !min-h-9 text-[0.85rem]" name="quantity" type="number" step="0.001" value={i.quantity} /><input class="input !min-h-9 w-14 text-[0.85rem]" name="unit" value={i.unit} /></span>
                  <input class="input !min-h-9 text-[0.85rem]" name="unit_price" type="number" step="0.01" value={i.unit_price} />
                  {trade && <>
                    <select class="input !min-h-9 text-[0.85rem]" name="supplier_id"><option value="">—</option>{suppliers.map(([k, l]) => <option value={k} selected={i.supplier_id === k}>{l}</option>)}</select>
                    <input class="input !min-h-9 text-[0.85rem]" name="unit_cost" type="number" step="0.01" value={i.unit_cost ?? ''} placeholder="costo" />
                    <input class="input !min-h-9 text-[0.85rem]" name="commission_percent" type="number" step="0.01" value={i.commission_percent ?? ''} placeholder="%" />
                  </>}
                  <span class="flex gap-1"><button class="btn btn-outline btn-sm" name="action" value="update">Salva</button><button class="btn btn-sm border border-danger text-danger" name="action" value="delete">×</button></span>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <form method="post" action="/api/admin/quotes/item" class="mt-4 grid items-end gap-3 border-t border-stone pt-4 md:grid-cols-4">
      <input type="hidden" name="quote_id" value={id} /><input type="hidden" name="action" value="create" />
      <label class="field"><span class="field-label">Marmo del catalogo</span><select class="input" name="marble_slug"><option value="">—</option>{marbles.map(([k, l]) => <option value={k}>{l}</option>)}</select></label>
      <label class="field md:col-span-3"><span class="field-label">Descrizione *</span><input class="input" name="description" required placeholder="es. Statuario, lastre 2 cm, finitura lucida" /></label>
      <label class="field"><span class="field-label">Finitura</span><input class="input" name="finish" /></label>
      <label class="field"><span class="field-label">Spessore</span><input class="input" name="thickness" /></label>
      <label class="field"><span class="field-label">Quantità</span><input class="input" name="quantity" type="number" step="0.001" value="1" /></label>
      <label class="field"><span class="field-label">Unità</span><input class="input" name="unit" value="m2" /></label>
      <label class="field"><span class="field-label">Prezzo unitario cliente</span><input class="input" name="unit_price" type="number" step="0.01" value="0" /></label>
      {trade && <>
        <label class="field"><span class="field-label">Fornitore (riservato)</span><select class="input" name="supplier_id"><option value="">—</option>{suppliers.map(([k, l]) => <option value={k}>{l}</option>)}</select></label>
        <label class="field"><span class="field-label">Materiale/lotto (riservato)</span><select class="input" name="material_id"><option value="">—</option>{materials.map(([k, l]) => <option value={k}>{l}</option>)}</select></label>
        <label class="field"><span class="field-label">Costo unitario (riservato)</span><input class="input" name="unit_cost" type="number" step="0.01" /></label>
        <label class="field"><span class="field-label">Provvigione % (brokerage)</span><input class="input" name="commission_percent" type="number" step="0.01" /></label>
      </>}
      <div><button class="btn btn-primary btn-sm" type="submit">Aggiungi riga</button></div>
    </form>
  </section>

  <section class="adm-card mt-6">
    <h2 class="font-display text-xl">Azioni</h2>
    <div class="mt-4 flex flex-wrap gap-3">
      <form method="post" action="/api/admin/quotes/action"><input type="hidden" name="id" value={id} /><button class="btn btn-primary btn-sm" name="action" value="send" disabled={!items.length}>Invia al cliente</button></form>
      <form method="post" action="/api/admin/quotes/action"><input type="hidden" name="id" value={id} /><button class="btn btn-outline btn-sm" name="action" value="deposit" disabled={!stripeConfigured() || !deposit || !revenue}>Link pagamento acconto {deposit ? `(${deposit}%)` : ''}</button></form>
      {trade && <form method="post" action="/api/admin/quotes/action"><input type="hidden" name="id" value={id} /><button class="btn btn-outline btn-sm" name="action" value="deal">Apri trattativa {row.model === 'brokerage' ? 'brokerage' : 'trading'}</button></form>}
      {row.status === 'accepted' && <form method="post" action="/api/admin/quotes/action"><input type="hidden" name="id" value={id} /><button class="btn btn-outline btn-sm" name="action" value="order">Crea ordine</button></form>}
      <a href={`/it/account/quotes/${id}/`} class="btn btn-outline btn-sm" target="_blank" rel="noopener">Anteprima cliente</a>
    </div>
    <p class="mt-3 text-[0.82rem] text-ash">«Invia al cliente» rende visibile il preventivo nell'area clienti e invia un'email nella lingua del cliente. Senza account, il cliente riceve l'email con l'invito a registrarsi con lo stesso indirizzo.</p>
  </section>

  <RecordForm r={r} row={row} options={options} profile={admin.profile} back={`/admin/quotes/${id}/`} />
</Admin>
