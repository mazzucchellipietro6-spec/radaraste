---
// Verifica in due passaggi (TOTP) obbligatoria per staff e amministratori.
import '~/styles/global.css';
import { supabaseFor } from '~/lib/server/auth';
export const prerender = false;
const admin = Astro.locals.admin;
if (!admin) return Astro.redirect('/it/account/login/?next=/admin/');
if (admin.user.aal === 'aal2') return Astro.redirect('/admin/');
const sb = supabaseFor(Astro);
const { data: factors } = await sb.auth.mfa.listFactors();
let verified = factors?.totp?.find((f) => f.status === 'verified');
let enroll: { id: string; qr: string; secret: string } | null = null;
if (!verified) {
  for (const f of factors?.all ?? []) if (f.status !== 'verified') await sb.auth.mfa.unenroll({ factorId: f.id }).catch(() => {});
  const { data } = await sb.auth.mfa.enroll({ factorType: 'totp', friendlyName: `WHITE CARRARA ${new Date().toISOString().slice(0, 10)}` });
  if (data) enroll = { id: data.id, qr: data.totp.qr_code, secret: data.totp.secret };
}
const factorId = verified?.id ?? enroll?.id ?? '';
const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" />
    <title>Verifica in due passaggi — WHITE CARRARA</title>
  </head>
  <body class="bg-texture">
    <main class="container-page flex min-h-screen items-center justify-center py-16">
      <div class="w-full max-w-md border border-stone bg-marble p-8">
        <p class="font-display text-xl tracking-[0.3em]">WHITE CARRARA</p>
        <h1 class="display-md mt-6">Verifica in due passaggi</h1>
        <p class="mt-3 text-[0.95rem] text-ash">Per proteggere il pannello serve un codice generato da un'app di autenticazione (Google Authenticator, 1Password, Authy…).</p>
        {
          enroll && (
            <div class="mt-6">
              <p class="text-[0.95rem]">Inquadrate il codice QR con l'app, poi inserite il codice di 6 cifre.</p>
              <img src={enroll.qr} alt="Codice QR per l'app di autenticazione" width="200" height="200" class="mx-auto mt-4 bg-white p-2" />
              <p class="mt-3 text-[0.8rem] text-ash">Oppure inserite questa chiave: <code class="break-all text-graphite" data-secret>{enroll.secret}</code></p>
            </div>
          )
        }
        {error && <p class="mt-4 text-danger" role="alert">Codice non valido, riprovate.</p>}
        <form method="post" action="/api/admin/mfa/verify" class="mt-6 space-y-4">
          <input type="hidden" name="factorId" value={factorId} />
          <label class="field"><span class="field-label">Codice di 6 cifre</span><input class="input text-center text-2xl tracking-[0.4em]" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus /></label>
          <button class="btn btn-primary w-full" type="submit">Verifica</button>
        </form>
      </div>
    </main>
  </body>
</html>
