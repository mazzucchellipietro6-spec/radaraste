---
import Base from './Base.astro';
import Icon from '~/components/Icon.astro';
import type { Translator } from '~/i18n';
import type { Profile } from '~/lib/server/auth';

interface Props {
  t: Translator;
  path: string;
  section: string;
  title: string;
  profile?: Profile | null;
}
const { t: tr, path, section, title, profile } = Astro.props;
const { t, lang } = tr;
const base = `/${lang}/account`;
const items = [
  ['overview', '', 'grid'],
  ['profile', 'profile/', 'user'],
  ['favorites', 'favorites/', 'heart'],
  ['projects', 'projects/', 'folder'],
  ['requests', 'requests/', 'chat'],
  ['quotes', 'quotes/', 'document'],
  ['bookings', 'bookings/', 'calendar'],
  ['documents', 'documents/', 'layers'],
  ['messages', 'messages/', 'mail'],
  ['b2b', 'b2b/', 'lock'],
] as const;
const ok = Astro.url.searchParams.get('ok');
const isStaff = profile && (profile.role === 'admin' || profile.role === 'staff');
---

<Base t={tr} title={`${title} — ${t('account.title')}`} path={path} noindex>
  <section class="bg-texture border-b border-stone">
    <div class="container-page py-10 lg:py-14">
      <p class="eyebrow">{t('account.title')}</p>
      <h1 class="display-lg mt-3">{title}</h1>
    </div>
  </section>
  <div class="container-page grid gap-10 py-12 lg:grid-cols-[15rem_1fr] lg:py-16">
    {
      profile && (
        <nav aria-label={t('account.title')} class="lg:sticky lg:top-36 lg:self-start">
          <ul class="flex gap-1 overflow-x-auto pb-2 lg:flex-col lg:overflow-visible">
            {items.map(([k, href, icon]) => (
              <li>
                <a href={`${base}/${href}`} aria-current={section === k ? 'page' : undefined} class="acc-link">
                  <Icon name={icon} size={17} />
                  {t(`account.nav.${k}`)}
                </a>
              </li>
            ))}
            {isStaff && (
              <li>
                <a href="/admin/" class="acc-link">
                  <Icon name="shield" size={17} />
                  {t('account.nav.admin')}
                </a>
              </li>
            )}
            <li class="lg:mt-4 lg:border-t lg:border-stone lg:pt-4">
              <form method="post" action="/api/auth/logout">
                <input type="hidden" name="lang" value={lang} />
                <button type="submit" class="acc-link w-full">
                  <Icon name="arrow" size={17} class="rtl:-scale-x-100" />
                  {t('account.nav.logout')}
                </button>
              </form>
            </li>
          </ul>
        </nav>
      )
    }
    <div class:list={['min-w-0', !profile && 'lg:col-span-2']}>
      {ok && <p class="mb-8 border border-success bg-white px-4 py-3 text-success" role="status">{ok === 'saved' ? t('account.profile.saved') : ok === 'sent' ? t('account.messages.sent') : ok === 'accepted' ? t('account.quotes.accepted') : ok === 'rejected' ? t('account.quotes.rejected') : ok === 'applied' ? t('account.b2b.applied') : ok === 'password' ? t('account.reset.done') : '✓'}</p>}
      <slot />
    </div>
  </div>
</Base>

<style>
  .acc-link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.8rem;
    font-size: 0.92rem;
    color: var(--color-graphite);
    text-decoration: none;
    white-space: nowrap;
    border-inline-start: 2px solid transparent;
  }
  .acc-link:hover {
    background: var(--color-ivory);
  }
  .acc-link[aria-current='page'] {
    border-inline-start-color: var(--color-brass);
    background: var(--color-ivory);
    font-weight: 500;
  }
</style>
