---
import FormShell from './FormShell.astro';
import Field from './Field.astro';
import type { Translator } from '~/i18n';

interface Props {
  t: Translator;
  interest?: string;
  compact?: boolean;
  source?: string;
  prefill?: boolean;
}
const { t: tr, interest = '', compact = false, source = 'quote', prefill = false } = Astro.props;
const { t, lang } = tr;
const interests = ['marble', 'experience', 'tour', 'trade', 'other'].map((v) => ({ value: v, label: t(`forms.interestOptions.${v}`) }));
---

<FormShell t={tr} action="/api/forms/quote" submitLabel={t('forms.submitQuote')} id={`quote-${source}`} hidden={{ source }}>
  {
    prefill && (
      <div data-quote-prefill data-lang={lang} hidden>
        <p class="field-label">{t('quotePage.selected')}</p>
        <ul class="mt-2 flex flex-wrap gap-2" data-quote-chips />
        <input type="hidden" name="marbles" value="" data-quote-marbles />
        <input type="hidden" name="doc" value="" data-quote-doc />
      </div>
    )
  }
  <div class="grid gap-5 sm:grid-cols-2">
    <Field name="name" label={t('forms.name')} required autocomplete="name" />
    <Field name="email" type="email" label={t('forms.email')} required autocomplete="email" dir="ltr" />
    {!compact && <Field name="phone" type="tel" label={t('forms.phone')} autocomplete="tel" optionalLabel={t('common.optional')} dir="ltr" />}
    {!compact && <Field name="company" label={t('forms.company')} autocomplete="organization" optionalLabel={t('common.optional')} />}
  </div>
  <Field name="interest" type="select" label={t('forms.interest')} options={interests} value={interest} placeholder={t('forms.choose')} required />
  <Field name="message" type="textarea" label={t('forms.message')} placeholder={t('forms.messagePlaceholder')} required rows={compact ? 4 : 6} />
</FormShell>

<script>
  // Precompila il modulo con i marmi scelti altrove (?marble=, ?selection=, ?collection=, ?interest=, ?doc=1)
  const box = document.querySelector<HTMLElement>('[data-quote-prefill]');
  if (box) {
    const p = new URLSearchParams(location.search);
    const slugs = [p.get('marble'), p.get('selection'), p.get('collection')]
      .filter(Boolean)
      .flatMap((v) => v!.split(','))
      .map((s) => s.trim())
      .filter((s) => /^[a-z0-9-]{1,80}$/.test(s));
    const form = box.closest('form')!;
    const interest = form.querySelector<HTMLSelectElement>('select[name="interest"]');
    const want = p.get('interest');
    if (interest && want && Array.from(interest.options).some((o) => o.value === want)) interest.value = want;
    if (slugs.length) {
      if (interest && !want) interest.value = 'marble';
      box.querySelector<HTMLInputElement>('[data-quote-marbles]')!.value = Array.from(new Set(slugs)).join(',');
      if (p.get('doc')) box.querySelector<HTMLInputElement>('[data-quote-doc]')!.value = '1';
      fetch(`/${box.dataset.lang}/catalogue.json`)
        .then((r) => r.json())
        .then((d: { items: { slug: string; name: string }[] }) => {
          const ul = box.querySelector('[data-quote-chips]')!;
          for (const s of new Set(slugs)) {
            const it = d.items.find((i) => i.slug === s);
            if (!it) continue;
            const li = document.createElement('li');
            li.className = 'chip is-on';
            li.textContent = it.name;
            ul.appendChild(li);
          }
          box.hidden = !ul.children.length;
        })
        .catch(() => {});
    }
  }
</script>
