---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Img from '~/components/Img.astro';
import Icon from '~/components/Icon.astro';
import Facts from '~/components/Facts.astro';
import CtaBand from '~/components/CtaBand.astro';
import type { Translator } from '~/i18n';
import { experiences, homeImages } from '~/lib/site';
import { VOCAB } from '~/data/vocab.mjs';

interface Props {
  t: Translator;
  path: string;
}
const { t: tr, path } = Astro.props;
const { t, href } = tr;
const img = await homeImages();
const list = (await experiences()).map((e) => ({ ...e, data: tr.localize('experiences', e.id, e.data) }));
const cats = Object.keys(VOCAB.experienceCategory).filter((c) => list.some((e) => e.data.category === c));
const crumbs = [{ label: t('nav.home'), href: href('home') }, { label: t('nav.experience') }];
---

<Base t={tr} title={t('experience.seoTitle')} fullTitle description={t('experience.seoDescription')} path={path} header="overlay" image={img.experience}>
  <PageHero eyebrow={t('experience.eyebrow')} title={t('experience.title')} lead={t('experience.lead')} image={img.experience} alt={t('home.experience.imageAlt')} crumbs={crumbs} crumbLabel={t('a11y.breadcrumb')} />

  <section class="py-20 lg:py-28">
    <div class="container-page">
      <div class="flex flex-wrap gap-2" role="group" aria-label={t('showroom.filters')} data-exp-filters>
        <button type="button" class="chip is-on" aria-pressed="true" data-cat="">{t('experience.all')}</button>
        {cats.map((c) => <button type="button" class="chip" aria-pressed="false" data-cat={c}>{t(`vocab.experienceCategory.${c}`)}</button>)}
      </div>
      <ul class="mt-12 grid gap-x-6 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
        {
          list.map((e, i) => (
            <li data-exp-cat={e.data.category} data-reveal style={`--reveal-delay:${(i % 3) * 0.07}s`}>
              <article class="group flex h-full flex-col">
                <a href={href('experienceItem', e.id)} class="card-hover block overflow-hidden bg-stone" tabindex="-1" aria-hidden="true">
                  <Img src={e.data.image} alt={e.data.imageAlt} sizes="(min-width: 1024px) 31vw, (min-width: 768px) 48vw, 100vw" widths={[480, 720, 960, 1280]} class="aspect-[4/3] w-full object-cover" />
                </a>
                <p class="eyebrow mt-6">{t(`vocab.experienceCategory.${e.data.category}`)}</p>
                <h2 class="mt-2 font-display text-[1.75rem] leading-tight">
                  <a href={href('experienceItem', e.id)} class="text-graphite no-underline hover:text-brass-deep">{e.data.title}</a>
                </h2>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-ash">{e.data.summary}</p>
                <div class="mt-5 border-t border-stone pt-5">
                  <Facts t={tr} d={e.data} compact />
                </div>
                <div class="mt-auto flex flex-wrap gap-3 pt-6">
                  <a href={`${href('booking')}?experience=${e.id}`} class="btn btn-primary btn-sm">{e.data.price != null && e.data.onlinePayment ? t('experience.book') : t('experience.requestInfo')}</a>
                  <a href={href('experienceItem', e.id)} class="btn btn-outline btn-sm">{t('common.learnMore')}</a>
                </div>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-ivory py-20 lg:py-24" aria-labelledby="how-title">
    <div class="container-page grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="how-title" class="display-md">{t('experience.howItWorks')}</h2>
        <p class="mt-6 flex gap-3 text-[0.9rem] text-ash"><Icon name="shield" size={18} class="mt-0.5 shrink-0 text-brass-deep" />{t('experience.authorizedNote')}</p>
      </div>
      <ol class="grid gap-8 sm:grid-cols-3 lg:col-span-7 lg:col-start-6">
        {
          ['1', '2', '3'].map((n) => (
            <li class="border-t border-stone pt-5">
              <span class="font-display text-3xl text-brass-deep">0{n}</span>
              <p class="mt-3">{t(`experience.steps.${n}`)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <CtaBand t={tr} />
</Base>

<script>
  const bar = document.querySelector('[data-exp-filters]');
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cat]');
    if (!btn) return;
    bar.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach((b) => {
      const on = b === btn;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', String(on));
    });
    const cat = btn.dataset.cat;
    document.querySelectorAll<HTMLElement>('[data-exp-cat]').forEach((li) => (li.hidden = !!cat && li.dataset.expCat !== cat));
  });
</script>
