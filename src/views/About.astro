---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Img from '~/components/Img.astro';
import Icon from '~/components/Icon.astro';
import CtaBand from '~/components/CtaBand.astro';
import type { Translator } from '~/i18n';
import aboutImg from '~/assets/images/pages/about.jpg';
import detailImg from '~/assets/images/pages/about-detail.jpg';
interface Props {
  t: Translator;
  path: string;
}
const { t: tr, path } = Astro.props;
const { t, href } = tr;
const what = [
  ['trade', 'diamond', href('trade')],
  ['brokerage', 'chat', href('trade')],
  ['sourcing', 'search', href('marbles')],
  ['export', 'ship', href('trade')],
  ['tourism', 'mountain', href('experience')],
  ['tours', 'compass', href('tours')],
] as const;
const crumbs = [{ label: t('nav.home'), href: href('home') }, { label: t('nav.about') }];
---

<Base t={tr} title={t('about.seoTitle')} description={t('about.seoDescription')} path={path} header="overlay" image={aboutImg}>
  <PageHero eyebrow={t('about.eyebrow')} title={t('about.title')} lead={t('about.lead')} image={aboutImg} alt={t('about.carraraTitle')} crumbs={crumbs} crumbLabel={t('a11y.breadcrumb')} />
  <section class="py-20 lg:py-28">
    <div class="container-page grid items-center gap-14 lg:grid-cols-12">
      <div class="prose-luxe text-[1.1rem] lg:col-span-6" data-reveal>
        <p>{t('about.p1')}</p>
        <p>{t('about.p2')}</p>
      </div>
      <div class="lg:col-span-5 lg:col-start-8" data-reveal>
        <div class="aspect-[4/5] overflow-hidden bg-stone"><Img src={detailImg} alt={t('about.carraraTitle')} sizes="(min-width: 1024px) 38vw, 100vw" class="h-full w-full object-cover" /></div>
      </div>
    </div>
  </section>
  <section class="bg-ivory py-20 lg:py-24" aria-labelledby="what-title">
    <div class="container-page">
      <h2 id="what-title" class="display-md">{t('about.whatTitle')}</h2>
      <ul class="mt-10 grid gap-px border border-stone bg-stone sm:grid-cols-2 lg:grid-cols-3">
        {what.map(([k, icon, url]) => (
          <li class="bg-ivory"><a href={url} class="flex h-full items-center gap-4 p-7 no-underline hover:bg-marble"><Icon name={icon} size={26} class="shrink-0 text-brass" stroke={1.1} /><span class="font-display text-xl text-graphite">{t(`about.what.${k}`)}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
  <section class="py-20 lg:py-28" aria-labelledby="values-title">
    <div class="container-page">
      <h2 id="values-title" class="display-md">{t('about.valuesTitle')}</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3">
        {['selection', 'transparency', 'hospitality'].map((k, i) => (
          <div class="border-t border-stone pt-6" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            <span class="font-display text-3xl text-brass-deep">0{i + 1}</span>
            <h3 class="mt-3 font-display text-2xl">{t(`about.values.${k}.title`)}</h3>
            <p class="mt-3 text-ash">{t(`about.values.${k}.text`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="bg-texture py-20 lg:py-28">
    <div class="container-page max-w-3xl text-center" data-reveal>
      <span class="rule mx-auto" aria-hidden="true"></span>
      <h2 class="display-md mt-8">{t('about.carraraTitle')}</h2>
      <p class="lead mt-6">{t('about.carraraText')}</p>
      <a href={href('experience')} class="link-luxe mt-8 text-graphite">{t('home.heroCtaCarrara')}</a>
    </div>
  </section>
  <CtaBand t={tr} />
</Base>
