---
import { getImage } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Img from '~/components/Img.astro';
import Icon from '~/components/Icon.astro';
import CtaBand from '~/components/CtaBand.astro';
import type { Translator } from '~/i18n';
import { destinations } from '~/lib/site';
import { absUrl, breadcrumbJsonLd } from '~/lib/seo';

interface Props {
  t: Translator;
  path: string;
  id: string;
}
const { t: tr, path, id } = Astro.props;
const { t, href } = tr;
const all = await destinations();
const d = tr.localize('destinations', id, all.find((x) => x.id === id)!.data);
const near = all
  .filter((x) => x.id !== id && x.data.region === d.region)
  .concat(all.filter((x) => x.id !== id && x.data.region !== d.region))
  .slice(0, 3)
  .map((x) => ({ ...x, data: tr.localize('destinations', x.id, x.data) }));
const crumbs = [{ label: t('nav.home'), href: href('home') }, { label: t('nav.tours'), href: href('tours') }, { label: d.name }];
const requestHref = `${href('booking')}?destination=${id}`;
const og = await getImage({ src: d.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ld = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name: d.name,
  description: d.tagline,
  image: absUrl(og.src),
  url: absUrl(path),
  containedInPlace: { '@type': 'AdministrativeArea', name: t(`vocab.region.${d.region}`), containedInPlace: { '@type': 'Country', name: 'Italia' } },
  includesAttraction: d.attractions.map((a) => ({ '@type': 'TouristAttraction', name: a })),
};
const services = [
  { on: d.privateTours, icon: 'compass', label: t('tours.privateTours') },
  { on: d.transfer, icon: 'car', label: t('tours.transfer') },
  { on: d.guides, icon: 'people', label: t('tours.guides') },
] as const;
---

<Base t={tr} title={d.seoTitle || `${d.name} — ${t('nav.tours')}`} description={d.seoDescription || d.tagline} path={path} header="overlay" image={d.image} jsonld={[ld, breadcrumbJsonLd(crumbs.map((c) => ({ name: c.label, url: c.href ?? path })))]}>
  <PageHero eyebrow={t(`vocab.region.${d.region}`)} title={d.name} lead={d.tagline} image={d.image} alt={d.imageAlt} crumbs={crumbs} crumbLabel={t('a11y.breadcrumb')}>
    <a href={requestHref} class="btn btn-light mt-10">{t('tours.request')}</a>
  </PageHero>

  <section class="py-20 lg:py-28">
    <div class="container-page grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="prose-luxe text-[1.1rem]" set:html={d.description} />
        {
          d.itineraries.length > 0 && (
            <div class="mt-14">
              <h2 class="eyebrow">{t('tours.itineraries')}</h2>
              <ul class="mt-6 space-y-6">
                {d.itineraries.map((it) => (
                  <li class="border-s-2 border-brass ps-6">
                    <h3 class="font-display text-2xl">{it.title}</h3>
                    <p class="mt-2 text-ash">{it.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
      <div class="space-y-12 lg:col-span-4 lg:col-start-9">
        <div>
          <h2 class="eyebrow">{t('tours.attractions')}</h2>
          <ul class="mt-5 divide-y divide-stone border-y border-stone">
            {d.attractions.map((a) => <li class="flex gap-3 py-3"><Icon name="pin" size={17} class="mt-1 shrink-0 text-brass-deep" />{a}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="eyebrow">{t('tours.experiences')}</h2>
          <ul class="mt-5 space-y-3">
            {d.experiences.map((x) => <li class="flex gap-3"><Icon name="check" size={17} class="mt-1 shrink-0 text-brass-deep" />{x}</li>)}
          </ul>
        </div>
        <div class="border border-stone bg-ivory p-7">
          <h2 class="eyebrow">{t('tours.services')}</h2>
          <ul class="mt-5 space-y-3">
            {services.filter((s) => s.on).map((s) => <li class="flex items-center gap-3"><Icon name={s.icon} size={19} class="text-brass-deep" />{s.label} <span class="text-[0.82rem] text-ash">· {t('tours.onRequest')}</span></li>)}
          </ul>
          <a href={requestHref} class="btn btn-primary mt-7 w-full">{t('tours.request')}</a>
          <p class="mt-5 text-[0.8rem] text-ash">{t('tours.noInvent')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ivory py-20 lg:py-24" aria-labelledby="near-title">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="near-title" class="display-md">{t('tours.other')}</h2>
        <a href={href('customTrip')} class="link-luxe text-graphite">{t('tours.customCta')}</a>
      </div>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {
          near.map((n) => (
            <li>
              <a href={href('destination', n.id)} class="card-hover group block no-underline">
                <div class="overflow-hidden bg-stone"><Img src={n.data.image} alt={n.data.imageAlt} sizes="(min-width: 768px) 31vw, 100vw" widths={[400, 640, 900]} class="aspect-[4/3] w-full object-cover" /></div>
                <p class="eyebrow mt-5">{t(`vocab.region.${n.data.region}`)}</p>
                <h3 class="mt-2 font-display text-2xl text-graphite">{n.data.name}</h3>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaBand t={tr} href={requestHref} label={t('tours.request')} />
</Base>
