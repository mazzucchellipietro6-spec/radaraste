---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Img from '~/components/Img.astro';
import CtaBand from '~/components/CtaBand.astro';
import type { Translator } from '~/i18n';
import { projects } from '~/lib/site';
import { VOCAB } from '~/data/vocab.mjs';
import projectsImg from '~/assets/images/pages/projects.jpg';
interface Props {
  t: Translator;
  path: string;
}
const { t: tr, path } = Astro.props;
const { t, href } = tr;
const list = (await projects()).map((p) => ({ ...p, data: tr.localize('projects', p.id, p.data) }));
const crumbs = [{ label: t('nav.home'), href: href('home') }, { label: t('nav.projects') }];
---

<Base t={tr} title={t('projects.seoTitle')} description={t('projects.seoDescription')} path={path} header="overlay" image={projectsImg}>
  <PageHero eyebrow={t('projects.eyebrow')} title={t('projects.title')} lead={t('projects.lead')} image={projectsImg} alt={t('projects.title')} crumbs={crumbs} crumbLabel={t('a11y.breadcrumb')} />
  <section class="py-20 lg:py-24" aria-labelledby="types-title">
    <div class="container-page">
      <h2 id="types-title" class="display-md">{t('projects.typesTitle')}</h2>
      <ul class="mt-10 flex flex-wrap gap-3">
        {Object.keys(VOCAB.projectType).map((k) => <li class="border border-stone px-5 py-3 font-display text-lg">{t(`vocab.projectType.${k}`)}</li>)}
      </ul>
    </div>
  </section>
  <section class="bg-ivory py-20 lg:py-24" aria-labelledby="cases-title">
    <div class="container-page">
      <h2 id="cases-title" class="display-md">{t('projects.caseStudies')}</h2>
      {
        list.length === 0 ? (
          <p class="lead mt-6 max-w-2xl">{t('projects.empty')}</p>
        ) : (
          <ul class="mt-10 grid gap-10 md:grid-cols-2">
            {list.map((p) => (
              <li>
                {p.data.cover && <div class="aspect-[4/3] overflow-hidden bg-stone"><Img src={p.data.cover} alt={p.data.title} sizes="(min-width: 768px) 48vw, 100vw" class="h-full w-full object-cover" /></div>}
                <p class="eyebrow mt-5">{t(`vocab.projectType.${p.data.type}`)}{p.data.location && ` · ${p.data.location}`}{p.data.year && ` · ${p.data.year}`}</p>
                <h3 class="mt-2 font-display text-2xl">{p.data.title}</h3>
                <p class="mt-3 text-ash">{p.data.summary}</p>
                <div class="prose-luxe mt-4 text-[0.95rem]" set:html={p.data.description} />
                {p.data.marbles.length > 0 && (
                  <p class="mt-4 text-[0.9rem]">
                    {t('projects.materials')}: {p.data.marbles.map((m, i) => <>{i > 0 && ', '}<a href={href('marble', m)} class="text-brass-deep">{m}</a></>)}
                  </p>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
  <section class="py-20 lg:py-24" aria-labelledby="pp-title">
    <div class="container-page">
      <h2 id="pp-title" class="display-md">{t('projects.processTitle')}</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-4">
        {['1', '2', '3', '4'].map((n) => <li class="border-t border-stone pt-5"><span class="font-display text-2xl text-brass-deep">0{n}</span><p class="mt-2">{t(`projects.process.${n}`)}</p></li>)}
      </ol>
    </div>
  </section>
  <CtaBand t={tr} />
</Base>
